# baresip "bob" (extension 1002). Audio is a 880 Hz sine in, a WAV file out: no sound devices.
poll_method		epoll
sip_listen		127.0.0.1:5072
net_interface		127.0.0.1
call_local_timeout	120
call_max_calls		4
audio_source		ausine,880
audio_player		aufile,/sipbed/out/bob-rx.wav
audio_alert		aufile,/dev/null
ausrc_srate		8000
auplay_srate		8000
rtp_ports		11100-11199
rtp_timeout		0
module_path		/usr/lib/baresip/modules
module			g711.so
module			ausine.so
module			aufile.so
module_app		account.so
module_app		menu.so
module_app		ctrl_tcp.so
ctrl_tcp_listen		0.0.0.0:4445
